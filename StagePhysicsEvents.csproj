<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Directory.Repo.props" Condition="Exists('Directory.Repo.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>StagePhysicsEvents</AssemblyName>
    <RootNamespace>REPOJP.StagePhysicsEvents</RootNamespace>
    <Authors>Codex</Authors>
    <Version>5.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <CopyFilesToPluginOutputDirectoryOnBuild>false</CopyFilesToPluginOutputDirectoryOnBuild>
    <CopyFilesToPluginOutputDirectoryOnRun>false</CopyFilesToPluginOutputDirectoryOnRun>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EventBuildInfo.cs" />
    <Compile Include="EventLanguage.cs" />
    <Compile Include="EventText.cs" />
    <Compile Include="EventTextLayout.cs" />
    <Compile Include="EventTextTokens.cs" />
    <Compile Include="EventGameLocalization.cs" />
    <Compile Include="EventMenuFont.cs" />
    <Compile Include="EventFontMaterial.cs" />
    <EmbeddedResource Include="Assets\Localization\*.json" LogicalName="REPOJP.StagePhysicsEvents.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\Localization\*.otf" LogicalName="REPOJP.StagePhysicsEvents.Assets.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\Localization\*.ttf" LogicalName="REPOJP.StagePhysicsEvents.Assets.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\Localization\OFL*.txt" LogicalName="REPOJP.StagePhysicsEvents.Assets.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\CheckpointRevenge.bundle" LogicalName="REPOJP.StagePhysicsEvents.Assets.Fonts.CheckpointRevenge" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" ExcludeAssets="contentFiles" />
  </ItemGroup>

  <!-- R.E.P.O. 0.5.1 uses Unity 6. Compile against the installed game, never the
       older 0.4.x NuGet libraries. Publicizing only creates an intermediate copy. -->
  <ItemGroup>
    <Reference Include="$(RepoGameManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Photon*.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="$(RepoGameManagedDir)/Klattersynth.dll" Private="false" />
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RepoGameManagedDir)' == '' Or !Exists('$(RepoGameManagedDir)/Assembly-CSharp.dll')"
           Text="Set RepoGameManagedDir to the R.E.P.O. 0.5.1 REPO_Data/Managed directory (in Directory.Repo.props or with -p:RepoGameManagedDir=...)." />
  </Target>

  <ItemGroup>
    <Reference Include="MenuLib"><HintPath>lib\MenuLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="EventGuideCatalog.cs" />
    <Compile Include="EventMenuState.cs" />
    <Compile Include="EventMenuPolicy.cs" />
    <Compile Include="EventMenu.cs" />
    <Compile Include="EventMenuLayout.cs" />
    <Compile Include="EventMenuButtonVisual.cs" />
    <Compile Include="EventGuideSnapshot.cs" />
    <Compile Include="CustomEventPresets.cs" />
    <Compile Include="EventMenuButton.cs" />
    <Compile Include="EventMenuScroll.cs" />
    <Compile Include="EventHudEditor.cs" />
    <Compile Include="EventBugReport.cs" />
    <Compile Include="StagePhysicsEventsPlugin.cs" />
    <Compile Include="StagePhysicsConfig.cs" />
    <Compile Include="EventConfigOrder.cs" />
    <Compile Include="StageFluxConfigMenu.cs" />
    <Compile Include="ExtendedEventConfig.cs" />
    <Compile Include="SunstoneEventConfig.cs" />
    <Compile Include="SunstoneEventAdapter.cs" />
    <Compile Include="SunstoneEventPolicy.cs" />
    <Compile Include="ExtendedEventPolicy.cs" />
    <Compile Include="ExtendedEventAdapter.cs" />
    <Compile Include="ExtendedEventPatches.cs" />
    <Compile Include="EventModels.cs" />
    <Compile Include="StagePhysicsEffectCarrierUtility.cs" />
    <Compile Include="PlayerAvatarState.cs" />
    <Compile Include="PlayerEffectCarrierUtility.cs" />
    <Compile Include="StageFluxCompatibilityApi.cs" />
    <Compile Include="CompatibilityApiContract.cs" />
    <Compile Include="EliteEnemyVariantsCompatibility.cs" />
    <Compile Include="RoleShuffleCompatibility.cs" />
    <Compile Include="PhysGrabObjectRegistry.cs" />
    <Compile Include="DeferredObjectCleanupQueue.cs" />
    <Compile Include="VanillaEffectResolver.cs" />
    <Compile Include="VanillaSpawnEffectResolver.cs" />
    <Compile Include="RandomStagePointSelector.cs" />
    <Compile Include="FeatherOrbEffectAdapter.cs" />
    <Compile Include="AdditionalOrbEffectAdapter.cs" />
    <Compile Include="VoidStaffEffectAdapter.cs" />
    <Compile Include="ValuableIndestructibleProtection.cs" />
    <Compile Include="ZeroGravityAffectBroadcaster.cs" />
    <Compile Include="VanillaGrenadeEventAdapter.cs" />
    <Compile Include="LevitationEventAdapter.cs" />
    <Compile Include="GumballHypnosisEventAdapter.cs" />
    <Compile Include="HealingAuraEventAdapter.cs" />
    <Compile Include="StarBarrageEventAdapter.cs" />
    <Compile Include="SpiderScareEventAdapter.cs" />
    <Compile Include="TrafficShockEventAdapter.cs" />
    <Compile Include="FlickerEventAdapter.cs" />
    <Compile Include="DangerousValuablesEventAdapter.cs" />
    <Compile Include="MinefieldEventAdapter.cs" />
    <Compile Include="EnemyWaveEventAdapter.cs" />
    <Compile Include="EnemyPlayerEventAdapter.cs" />
    <Compile Include="EnemyHuntEventAdapter.cs" />
    <Compile Include="EnemySpeedPatches.cs" />
    <Compile Include="StageWorldEventAdapter.cs" />
    <Compile Include="VanillaEventNotifier.cs" />
    <Compile Include="NotificationEnemyReactionGuard.cs" />
    <Compile Include="NotificationWindowCoordinator.cs" />
    <Compile Include="NotificationEnemyReactionPatches.cs" />
    <Compile Include="StagePhysicsEventController.cs" />
    <Compile Include="EventPresentation.cs" />
    <Compile Include="EventIconCatalog.cs" />
    <Compile Include="StagePhysicsEventHud.cs" />
    <Compile Include="LifecyclePatches.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\EventIcons\Runtime\*.png" />
    <EmbeddedResource Include="Assets\UI\Runtime\Lock.png" />
    <EmbeddedResource Include="Assets\UI\Runtime\Stopwatch.png" />
    <EmbeddedResource Include="Assets\UI\Runtime\Ready.png" />
    <EmbeddedResource Include="Assets\UI\Runtime\Panel.png" />
  </ItemGroup>

</Project>
